      "widgets_values": [
        "{\n  \"references\": {\n    \"picture_1\": {\n      \"input\": \"ref_image_1\",\n      \"tag\": \"<Picture 1>\",\n      \"role\": \"cat_identity_reference\",\n      \"instruction\": \"Use <Picture 1> as the authoritative reference for the cat's face, orange fur, large white eyes, red pupils, ears, white shirt, blue skirt, brown boots, tail, proportions, colors, and chibi design. Preserve this identity throughout.\"\n    },\n    \"first_frame\": {\n      \"input\": \"first_frame\",\n      \"role\": \"woman_identity_and_visual_style\",\n      \"instruction\": \"Use the first frame as the authoritative reference for the woman's black hair with blue highlights, blue eyes, white and gray outfit, camera, white background, lighting, rendering, line quality, colors, and overall 3D animation style.\"\n    }\n  },\n  \"character\": {\n    \"woman\": \"Keep the woman unchanged from the first frame. Her acting is cute, exaggerated, readable, and comedic.\",\n    \"cat\": \"The cat from <Picture 1> is hyperactive, cute, playful, and expressive. Preserve its face, eyes, fur, clothing, proportions, and tail.\"\n  },\n  \"environment\": {\n    \"location\": \"clean white studio space\",\n    \"background\": \"pure white, matching the first frame\",\n    \"floor\": \"white floor with soft contact shadows\",\n    \"lighting\": \"soft studio lighting matching the first frame\",\n    \"mood\": \"cute, surprising, fast-paced, comedic\",\n    \"continuity\": \"Do not change the background, lighting, rendering, or visual style.\"\n  },\n  \"style\": {\n    \"visual\": \"smooth game 3D CG animation matching the first frame\",\n    \"rendering\": \"clean anime-inspired 3D, crisp linework, soft shading, stable designs\",\n    \"animation\": \"strong anticipation, snap timing, squash and stretch, readable poses, short holds, delayed hair and clothing motion\",\n    \"motion_rules\": \"Use strong anticipation, fast snap movement, short reaction holds, squash and stretch, delayed hair and clothing motion, and stable recognizable faces.\"\n  },\n  \"camera\": {\n    \"opening\": \"Start from the exact first-frame composition and framing.\",\n    \"movement\": \"Mostly locked camera with a very subtle push-in during the final reaction.\",\n    \"framing\": \"Keep the woman and cat readable. Do not crop the main action.\",\n    \"cuts\": false,\n    \"unwanted_zoom\": false,\n    \"style_lock\": true\n  },\n  \"timeline\": [\n    {\n      \"time\": \"0.0-0.8s\",\n      \"camera\": \"Locked, matching the first frame.\",\n      \"scene\": \"The tired woman moves slightly through the white studio. Her shoulders are lowered, eyes half-open, and expression sleepy.\",\n      \"action\": \"She exhales and takes a small step. Hair and loose sleeves sway softly with delayed motion.\",\n      \"cat\": \"Not visible yet.\",\n      \"dialogue\": [],\n      \"audio\": \"Quiet room tone, soft footsteps, small tired sigh.\"\n    },\n    {\n      \"time\": \"0.8-1.2s\",\n      \"camera\": \"Locked; keep the woman's face visible.\",\n      \"scene\": \"The cat from <Picture 1> suddenly leaps into the frame directly toward the woman's face.\",\n      \"woman\": \"Eyes open wide, eyebrows shoot upward, mouth changes into a round open mouth, head leans backward. Cute exaggerated surprise, not fear.\",\n      \"cat\": \"Use a clear anticipation pose, fast jump, 2 to 3 frame motion smear, and a tiny cartoon surprise effect.\",\n      \"hold\": \"Hold the surprise for 0.15 seconds before contact.\",\n      \"dialogue\": [{\"speaker\": \"woman\", \"line\": \"えっ？\"}],\n      \"audio\": \"Short whoosh and surprised vocal reaction.\"\n    },\n    {\n      \"time\": \"1.2-2.0s\",\n      \"camera\": \"Follow slightly without changing style or composition.\",\n      \"scene\": \"The cat lands and clings to the woman's face like a cute cartoon mask, covering part of her cheeks and forehead without injury.\",\n      \"woman\": \"Upper body bends backward, arms lift, then she tries to regain balance. Hair and sleeves react with delayed motion.\",\n      \"cat\": \"Paws cling to her cheeks, body hangs forward, tail curls upward and swings. Keep large white eyes and red pupils visible.\",\n      \"hold\": \"Hold the face-clinging gag for 0.15 seconds.\",\n      \"dialogue\": [],\n      \"audio\": \"Soft cartoon impact, paw sounds, comedic squeak.\"\n    },\n    {\n      \"time\": \"2.0-3.0s\",\n      \"camera\": \"Stable medium framing.\",\n      \"scene\": \"The woman tries to remove the cat, but the cat remains attached.\",\n      \"woman\": \"She pulls three times. Cheeks puff, eyes squeeze shut, shoulders bounce. Expression changes from surprise to frustrated determination and exhausted disbelief.\",\n      \"cat\": \"Stretches slightly with squash and stretch, then returns to normal proportions. Paws remain attached and tail wiggles.\",\n      \"dialogue\": [{\"speaker\": \"woman\", \"line\": \"ちょっと、離れて！\"}],\n      \"audio\": \"Three pulling sounds with pauses: ぐっ、ぐぐっ、ぐぬぬ.\"\n    },\n    {\n      \"time\": \"3.0-4.0s\",\n      \"camera\": \"Very subtle push-in, no cut.\",\n      \"scene\": \"The cat releases its grip. The woman stumbles backward because her hands pull with no resistance.\",\n      \"woman\": \"She takes two quick steps, waves her arms, nearly falls, then regains balance. Hair and sleeves swing with delayed momentum.\",\n      \"cat\": \"Lands lightly, bounces once, then stands proudly as if nothing happened.\",\n      \"hold\": \"Briefly hold the woman's stunned silence and the cat's proud pose.\",\n      \"dialogue\": [],\n      \"audio\": \"Release sound, light footsteps, comedic bounce.\"\n    },\n    {\n      \"time\": \"4.0-5.0s\",\n      \"camera\": \"Subtle final push-in; keep both faces visible.\",\n      \"scene\": \"The woman bends forward with hands on knees, exhausted. The cat stands beside her and tilts its head.\",\n      \"woman\": \"Shoulders rise and fall with exaggerated breathing. Hair is slightly disheveled. She looks at the cat with half-open tired eyes.\",\n      \"cat\": \"Blinks once, waves with one paw, and curls its tail into a question mark.\",\n      \"final_pose\": \"Hold for 0.4 seconds: exhausted woman beside cheerful cat.\",\n      \"dialogue\": [{\"speaker\": \"woman\", \"line\": \"ぜーっ、はーっ……\"}],\n      \"audio\": \"Heavy comedic breathing, cat chirp, soft sigh.\"\n    }\n  ],\n  \"audio_design\": {\n    \"native_audio\": true,\n    \"dialogue\": \"Clear and synchronized.\",\n    \"ambience\": \"Quiet studio room tone.\",\n    \"foley\": \"Footsteps, cloth, paw sounds, impacts, whooshes, and bounce sounds.\",\n    \"music\": \"\"\n  },\n  \"continuity_rules\": [\n    \"The first frame controls the woman's identity, style, camera, background, lighting, and palette.\",\n  \"<Picture 1> controls the cat's identity and design.\",\n  \"The cat clings to her face in a cute cartoon way; no injury or horror.\",\n  \"Keep both faces recognizable; no cuts, random camera changes, unwanted zoom, extra characters, or new props.\",\n  \"Use anticipation before fast movement and short holds after reactions.\",\n  \"Return characters to normal proportions after squash and stretch.\",\n  \"Preserve the woman's hair, eyes, outfit, proportions, and the cat's eyes, fur, clothing, boots, and tail.\",\n  \"Keep the final tone cute, playful, and comedic.\"\n  ]\n}\n"
